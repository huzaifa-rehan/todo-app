# Postgres (Neon). From Vercel → Settings → Environment Variables → DATABASE_URL.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Local only; on Vercel the URL is detected automatically.
BETTER_AUTH_URL=http://localhost:3000

# Optional: Google sign-in (Google Cloud Console → OAuth client). Leave empty to hide it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
